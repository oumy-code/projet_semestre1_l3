@model brasilBugerC_.Models.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Burger?.Nom ?? "Détails du burger";
}

<style>
    body {
        background-color: #f5f5f5;
    }
    
    .details-container {
        background: #fff;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        margin-bottom: 30px;
    }
    
    .product-image-section {
        padding: 30px;
        background: linear-gradient(135deg, #FFF9E6 0%, #FFE6B3 100%);
    }
    
    .product-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    
    .product-placeholder {
        width: 100%;
        height: 400px;
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    
    .product-placeholder span {
        font-size: 140px;
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2));
    }
    
    .product-info-section {
        padding: 40px 35px;
    }
    
    .product-name {
        font-size: 32px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
    }
    
    .product-price {
        font-size: 28px;
        font-weight: bold;
        color: #FFD700;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .product-price::before {
        content: '⚡';
        font-size: 32px;
    }
    
    .form-section {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 20px;
    }
    
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 12px;
        font-size: 16px;
    }
    
    .quantity-input {
        width: 120px;
        padding: 12px;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        text-align: center;
        transition: border-color 0.3s;
    }
    
    .quantity-input:focus {
        border-color: #FFD700;
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.1);
    }
    
    .complement-section {
        margin-bottom: 25px;
    }
    
    .complement-option {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 10px;
        border: 2px solid #e0e0e0;
        transition: all 0.3s;
        cursor: pointer;
    }
    
    .complement-option:hover {
        border-color: #FFD700;
        background: #fffef8;
    }
    
    .complement-option input[type="checkbox"] {
        width: 22px;
        height: 22px;
        cursor: pointer;
        accent-color: #FFD700;
    }
    
    .complement-option label {
        cursor: pointer;
        margin-left: 12px;
        font-weight: 500;
        color: #333;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .complement-price {
        color: #FFD700;
        font-weight: 600;
    }
    
    .btn-add-cart {
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        color: #fff;
        border: none;
        padding: 18px;
        border-radius: 15px;
        font-weight: bold;
        font-size: 18px;
        width: 100%;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(255, 165, 0, 0.3);
    }
    
    .btn-add-cart:hover {
        background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255, 165, 0, 0.4);
        color: #fff;
    }
    
    .btn-back {
        background: #fff;
        color: #666;
        border: 2px solid #e0e0e0;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }
    
    .btn-back:hover {
        border-color: #FFD700;
        color: #FFD700;
        background: #fffef8;
    }
    
    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    @@media (max-width: 768px) {
        .product-name {
            font-size: 24px;
        }
        
        .product-price {
            font-size: 22px;
        }
        
        .product-info-section {
            padding: 25px 20px;
        }
    }
</style>

<div class="details-container">
    <div class="row g-0">
        <div class="col-md-6 product-image-section">
            @if (!string.IsNullOrEmpty(Model.Burger?.Image))
            {
                <img src="@Model.Burger.Image" class="product-image" alt="@Model.Burger.Nom">
            }
            else
            {
                <div class="product-placeholder">
                    <span>🍔</span>
                </div>
            }
        </div>
        
        <div class="col-md-6 product-info-section">
            <h1 class="product-name">@Model.Burger?.Nom</h1>
            <div class="product-price">@Model.Burger?.Prix.ToString("N0") FCFA</div>
            
            <form asp-action="AddBurgerToPanier" method="post">
                <input type="hidden" name="id" value="@Model.Burger?.Id" />
                
                <div class="form-section">
                    <label class="form-label">Quantité</label>
                    <input type="number" name="quantite" value="1" min="1" max="10" class="quantity-input">
                </div>
                
                @if (Model.ComplementsFrites.Any())
                {
                    <div class="complement-section">
                        <div class="section-title">
                            🍟 Ajouter des frites ?
                        </div>
                        @foreach (var frite in Model.ComplementsFrites)
                        {
                            <div class="complement-option">
                                <input class="form-check-input" type="checkbox" name="complementIds" value="@frite.Id" id="frite_@frite.Id">
                                <label class="form-check-label" for="frite_@frite.Id">
                                    <span>@frite.Nom</span>
                                    <span class="complement-price">(+@frite.Prix.ToString("N0") FCFA)</span>
                                </label>
                            </div>
                        }
                    </div>
                }
                
                @if (Model.ComplementsBoissons.Any())
                {
                    <div class="complement-section">
                        <div class="section-title">
                            🥤 Ajouter une boisson ?
                        </div>
                        @foreach (var boisson in Model.ComplementsBoissons)
                        {
                            <div class="complement-option">
                                <input class="form-check-input" type="checkbox" name="complementIds" value="@boisson.Id" id="boisson_@boisson.Id">
                                <label class="form-check-label" for="boisson_@boisson.Id">
                                    <span>@boisson.Nom</span>
                                    <span class="complement-price">(+@boisson.Prix.ToString("N0") FCFA)</span>
                                </label>
                            </div>
                        }
                    </div>
                }
                
                <button type="submit" class="btn-add-cart">
                    🛒 Ajouter au panier
                </button>
            </form>
            
            <div class="mt-3">
                <a asp-action="Index" class="btn-back">
                    ← Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>