{% extends 'base.html.twig' %}

{% block title %}Nouveau Burger{% endblock %}

{% block body %}
<div style="padding: 40px; background-color: #f8f9fa; min-height: 100vh; font-family: 'Segoe UI', sans-serif;">
    <div style="max-width: 850px; margin: 0 auto;">
        
        {# En-tête avec lien retour #}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h1 style="font-weight: 800; color: #1a1a1a; margin: 0; font-size: 1.8rem;">🍔 Nouveau Burger</h1>
            <a href="{{ path('app_burger_index') }}" style="text-decoration: none; color: #6c757d; font-weight: 600; font-size: 0.9rem;">Annuler</a>
        </div>

        <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">
            {{ form_start(form) }}
                <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px;">
                    
                    {# Colonne de Gauche : Textes #}
                    <div>
                        <div style="margin-bottom: 25px;">
                            <label style="display: block; font-weight: 700; color: #4a5568; margin-bottom: 10px;">Nom du burger</label>
                            {{ form_widget(form.nom, {'attr': {'style': 'width:100%; padding:14px; border-radius:12px; border:1px solid #e2e8f0; background:#f8fafc; font-size: 1rem;', 'placeholder': 'Ex: Le Grand Brasil'}}) }}
                            <div style="color: #e53e3e; font-size: 0.85rem; margin-top: 5px;">{{ form_errors(form.nom) }}</div>
                        </div>
                        
                        <div style="margin-bottom: 25px;">
                            <label style="display: block; font-weight: 700; color: #4a5568; margin-bottom: 10px;">Prix de vente (FCFA)</label>
                            <div style="position: relative;">
                                {{ form_widget(form.prix, {'attr': {'style': 'width:100%; padding:14px 14px 14px 45px; border-radius:12px; border:1px solid #e2e8f0; background:#f8fafc; font-size: 1.1rem; font-weight: bold; color: #2d3748;'}}) }}
                                <span style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #a0aec0; font-weight: bold;">CFA</span>
                            </div>
                            <div style="color: #e53e3e; font-size: 0.85rem; margin-top: 5px;">{{ form_errors(form.prix) }}</div>
                        </div>
                    </div>

                    {# Colonne de Droite : Image #}
                    <div>
                        <label style="display: block; font-weight: 700; color: #4a5568; margin-bottom: 10px;">Visuel du produit</label>
                        <div style="border: 2px dashed #cbd5e0; border-radius: 15px; padding: 25px; text-align: center; background: #f8fafc; transition: 0.3s;" onmouseover="this.style.borderColor='#FFC107'" onmouseout="this.style.borderColor='#cbd5e0'">
                            <i class="fas fa-image" style="font-size: 2.5rem; color: #cbd5e0; margin-bottom: 15px;"></i>
                            <p style="font-size: 0.8rem; color: #718096; margin-bottom: 15px;">Collez l'URL de l'image ici</p>
                            {{ form_widget(form.image, {'attr': {'style': 'width:100%; padding:10px; border-radius:8px; border:1px solid #e2e8f0; font-size: 0.8rem;'}}) }}
                            <div style="color: #e53e3e; font-size: 0.85rem; margin-top: 5px;">{{ form_errors(form.image) }}</div>
                        </div>
                    </div>
                </div>

                <hr style="border: 0; border-top: 1px solid #edf2f7; margin: 35px 0;">

                {# Boutons d'action #}
                <div style="display: flex; gap: 15px; justify-content: flex-end;">
                    <a href="{{ path('app_burger_index') }}" style="background-color: #f1f5f9; color: #475569; border-radius: 12px; padding: 14px 30px; font-weight: 700; text-decoration: none; transition: 0.2s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">
                        Annuler
                    </a>
                    <button type="submit" style="background-color: #FFC107; color: #000; border-radius: 12px; padding: 14px 40px; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3); transition: 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                        ENREGISTRER LE BURGER
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
    /* Focus effects for form fields */
    input:focus {
        outline: none !important;
        border-color: #FFC107 !important;
        background: white !important;
        box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.1) !important;
    }
</style>
{% endblock %}