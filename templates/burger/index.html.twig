{% extends 'base.html.twig' %}

{% block title %}Gestion des Burgers{% endblock %}
{% block header_title %}Gestion des Burgers{% endblock %}

{% block body %}
<div style="padding: 20px; background-color: #f4f4f4; min-height: 100vh;">
    {# Barre d'action supérieure #}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1 style="font-size: 2rem; font-weight: bold; color: #333; margin: 0;">Liste des Burgers</h1>
        <a href="{{ path('app_burger_new') }}" style="background-color: #FFC107; color: white; border-radius: 10px; padding: 12px 20px; font-weight: bold; text-decoration: none; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-plus-circle"></i> Nouveau Burger
        </a>
    </div>

    {# Barre de recherche #}
    <form method="get" action="{{ path('app_burger_index') }}" style="margin-bottom: 30px; display: flex; gap: 10px;">
        <input type="text" name="search" value="{{ searchTerm }}" placeholder="Rechercher par nom..." style="width: 300px; padding: 12px; border-radius: 8px; border: 1px solid #ddd; outline: none;">
        <button type="submit" style="background-color: #333; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">
            Rechercher
        </button>
        {% if searchTerm %}
            <a href="{{ path('app_burger_index') }}" style="text-decoration: none; color: #666; align-self: center;">Effacer</a>
        {% endif %}
    </form>

    <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: #f8f9fa; color: #888; text-transform: lowercase; border-bottom: 2px solid #eee;">
                <tr>
                    <th style="padding: 15px; text-align: left; width: 120px;">image</th>
                    <th style="text-align: left; padding: 15px;">Nom</th>
                    <th style="text-align: left; padding: 15px;">Prix</th>
                    <th style="text-align: left; padding: 15px;">Statut</th>
                    <th style="text-align: center; padding: 15px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for burger in burgers %}
                {# EFFET GRIS SI ARCHIVÉ #}
                <tr style="border-bottom: 1px solid #eee; {{ burger.archive ? 'background-color: #fafafa; opacity: 0.7;' : '' }}">
                    <td style="padding: 15px;">
                        {% if burger.image %}
                            <img src="{{ burger.image }}" style="width: 100px; height: 70px; object-fit: cover; border-radius: 8px; {{ burger.archive ? 'filter: grayscale(1);' : '' }}" alt="{{ burger.nom }}">
                        {% else %}
                            <div style="width: 100px; height: 70px; background: #eee; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #999;">Pas d'image</div>
                        {% endif %}
                    </td>
                    <td style="font-weight: 600; vertical-align: middle; padding: 15px;">{{ burger.nom }}</td>
                    <td style="color: #e63946; font-weight: bold; vertical-align: middle; padding: 15px;">{{ burger.prix|number_format(0, '.', ' ') }} <small>FCFA</small></td>
                    <td style="vertical-align: middle; padding: 15px;">
                        {% if not burger.archive %}
                            <span style="background-color: #e6fffa; color: #38a169; padding: 6px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: bold;">Actif</span>
                        {% else %}
                            <span style="background-color: #fff5f5; color: #e53e3e; padding: 6px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: bold;">Archivé</span>
                        {% endif %}
                    </td>
                    <td style="text-align: center; vertical-align: middle; padding: 15px;">
                        <div style="display: flex; justify-content: center; gap: 15px; align-items: center;">
                            <a href="{{ path('app_burger_edit', {'id': burger.id}) }}" style="color: #FFC107; font-size: 1.1rem;" title="Modifier">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            
                            <form method="post" action="{{ path('app_burger_delete', {'id': burger.id}) }}" onsubmit="return confirm('Voulez-vous modifier le statut de ce burger ?');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ burger.id) }}">
                                
                                {# BOUTON DYNAMIQUE : RESTAURER OU ARCHIVER #}
                                <button type="submit" style="background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 0;">
                                    {% if burger.archive %}
                                        <i class="fas fa-undo-alt" style="color: #38a169;" title="Réactiver"></i>
                                    {% else %}
                                        <i class="fas fa-trash" style="color: #adb5bd;" title="Archiver"></i>
                                    {% endif %}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" style="padding: 30px; text-align: center; color: #999;">Aucun burger trouvé.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div style="margin-top: 20px; display: flex; justify-content: center; gap: 10px; align-items: center;">
        {% if pagesCount > 1 %}
            {% for i in 1..pagesCount %}
                <a href="{{ path('app_burger_index', {page: i, search: searchTerm}) }}" 
                   style="padding: 8px 15px; border-radius: 5px; text-decoration: none; 
                          {{ i == currentPage ? 'background: #FFC107; color: white;' : 'background: white; color: #333; border: 1px solid #ddd;' }}">
                    {{ i }}
                </a>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}