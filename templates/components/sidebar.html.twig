            </a>
        </li>

        {# Lien Burgers (Remplacez 'app_burger_index' par votre vraie route si différente) #}
       <li class="{{ app.request.attributes.get('_route') starts with 'app_burger' ? 'active' : '' }}">
            <a href="{{ path('app_burger_index') }}">
                <i class="fas fa-hamburger"></i> Burgers
            </a>
        </li>
        {# Lien Menu #}
      <li class="{{ app.request.attributes.get('_route') starts with 'app_menu' ? 'active' : '' }}">
    <a href="{{ path('app_menu_index') }}">
        <i class="fas fa-clipboard-list"></i>
        <span>Menus</span>
    </a>
</li>
       {# Lien Compléments #}
<li class="{{ app.request.attributes.get('_route') starts with 'app_complement' ? 'active' : '' }}">
    <a href="{{ path('app_complement_index') }}">
        <i class="fas fa-utensils"></i> 
        <span>Compléments</span>
    </a>
</li>
     {# LIEN COMMANDES : On active seulement si c'est la liste, l'ajout ou la modification (mais pas la livraison) #}
{% set currentRoute = app.request.attributes.get('_route') %}

<li class="{{ (currentRoute starts with 'app_commande' and currentRoute != 'app_commande_livraison') ? 'active' : '' }}">
    <a href="{{ path('app_commande_index') }}">
        <i class="fas fa-shopping-cart"></i> 
        <span>Commandes</span>
    </a>
</li>

{# LIEN LIVRAISONS : On active uniquement si c'est strictement la route de livraison #}
<li class="{{ currentRoute == 'app_commande_livraison' ? 'active' : '' }}">
    <a href="{{ path('app_commande_livraison') }}">
        <i class="fas fa-bicycle"></i> 
        <span>Livraisons</span>
    </a>
</li>
    </ul>
